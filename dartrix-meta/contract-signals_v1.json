{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dartrix.local/schemas/contract_signals_v1.json",
  "title": "DARTRIX Contract Signals v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["mission", "plan", "tasks", "filters", "sequence"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Schema or contract version string."
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Primary mission statement for the bridge."
    },
    "plan": {
      "type": "object",
      "required": ["objective", "steps"],
      "additionalProperties": true,
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "action": { "type": "string", "minLength": 1 },
                  "order": { "type": "number" }
                }
              }
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["title", "action"],
            "additionalProperties": true,
            "properties": {
              "id": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "integer" }
                ]
              },
              "title": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["field", "operator", "value"],
            "additionalProperties": true,
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "operator": { "type": "string", "minLength": 1 },
              "value": {}
            }
          }
        ]
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "type": "number" },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "order": { "type": "number" },
              "step": { "type": "string", "minLength": 1 },
              "task": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}